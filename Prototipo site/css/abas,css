/* =====================================
   PÁGINA INTELIGÊNCIA TERRITORIAL
===================================== */

.territorial-hero{

    display:grid;

    grid-template-columns:1fr 1fr;

    align-items:center;

    gap:60px;

    padding:140px 8% 100px;

    background:linear-gradient(135deg,#f8fbff,#eef6ff);

}

.hero-texto span{

    display:block;

    color:#1976d2;

    font-size:14px;

    font-weight:700;

    letter-spacing:2px;

    margin-bottom:15px;

}

.hero-texto h1{

    font-size:48px;

    color:#003366;

    line-height:60px;

    margin-bottom:25px;

}

.hero-texto p{

    font-size:18px;

    color:#555;

    line-height:32px;

    margin-bottom:40px;

}

.botao{

    display:inline-block;

    padding:15px 35px;

    background:#1976d2;

    color:#fff;

    text-decoration:none;

    border-radius:10px;

    font-weight:600;

    transition:.3s;

}

.botao:hover{

    background:#003366;

    transform:translateY(-4px);

}

.hero-imagem img{

    width:100%;

    border-radius:20px;

    box-shadow:0 20px 40px rgba(0,0,0,.15);

}

/* =====================================
   CONCEITO
===================================== */

.territorial-conceito{

    padding:100px 8%;

    background:#fff;

    text-align:center;

}

.territorial-conceito h2{

    color:#003366;

    font-size:38px;

    margin-bottom:25px;

}

.territorial-conceito>p{

    max-width:900px;

    margin:auto;

    color:#666;

    line-height:30px;

    font-size:18px;

}

.territorial-cards{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));

    gap:30px;

    margin-top:60px;

}

.territorial-card{

    background:#f8fafc;

    padding:35px;

    border-radius:18px;

    box-shadow:0 8px 25px rgba(0,0,0,.08);

    transition:.3s;

    border-top:5px solid #1976d2;

}

.territorial-card:hover{

    transform:translateY(-10px);

}

.territorial-card h3{

    color:#003366;

    margin-bottom:15px;

    font-size:24px;

}

.territorial-card p{

    color:#666;

    line-height:28px;

}

/* =====================================
   PROCESSO
===================================== */

.processo{

    padding:100px 8%;

    background:#f5f8fc;

}

.processo h2{

    text-align:center;

    color:#003366;

    font-size:38px;

    margin-bottom:60px;

}

.processo-grid{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(230px,1fr));

    gap:30px;

}

.processo-grid div{

    background:white;

    padding:35px;

    text-align:center;

    border-radius:18px;

    box-shadow:0 8px 20px rgba(0,0,0,.08);

}

.processo-grid span{

    display:inline-flex;

    justify-content:center;

    align-items:center;

    width:65px;

    height:65px;

    background:#1976d2;

    color:white;

    border-radius:50%;

    font-size:24px;

    font-weight:bold;

    margin-bottom:20px;

}

.processo-grid h3{

    color:#003366;

    margin-bottom:15px;

}

.processo-grid p{

    color:#666;

    line-height:26px;

}

/* =====================================
   TECNOLOGIAS
===================================== */

.ferramentas{

    padding:100px 8%;

    background:#fff;

}

.ferramentas h2{

    text-align:center;

    color:#003366;

    font-size:38px;

    margin-bottom:60px;

}

.ferramentas-grid{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

    gap:30px;

}

.ferramentas-grid div{

    background:#f8fafc;

    padding:35px;

    border-radius:18px;

    box-shadow:0 8px 20px rgba(0,0,0,.08);

    border-left:5px solid #1976d2;

    transition:.3s;

}

.ferramentas-grid div:hover{

    transform:translateY(-8px);

}

.ferramentas-grid h3{

    color:#003366;

    margin-bottom:15px;

}

.ferramentas-grid p{

    color:#666;

    line-height:28px;

}

/* =====================================
   RESULTADOS
===================================== */

.resultados{

    padding:100px 8%;

    background:linear-gradient(135deg,#003366,#1976d2);

    color:white;

    text-align:center;

}

.resultados h2{

    font-size:38px;

    margin-bottom:60px;

}

.numeros{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));

    gap:40px;

}

.numeros div{

    background:rgba(255,255,255,.12);

    backdrop-filter:blur(8px);

    border-radius:18px;

    padding:40px;

}

.numeros strong{

    display:block;

    font-size:58px;

    margin-bottom:15px;

}

.numeros p{

    font-size:18px;

}

/* =====================================
   RESPONSIVIDADE
===================================== */

@media(max-width:900px){

    .territorial-hero{

        grid-template-columns:1fr;

        text-align:center;

    }

    .hero-texto h1{

        font-size:38px;

        line-height:48px;

    }

}

@media(max-width:600px){

    .hero-texto h1{

        font-size:30px;

        line-height:40px;

    }

    .territorial-conceito h2,
    .processo h2,
    .ferramentas h2,
    .resultados h2{

        font-size:30px;

    }

    .numeros strong{

        font-size:45px;

    }

}

/* =====================================
   SISTEMA DE INFORMAÇÃO GEOGRÁFICA (SIG)
===================================== */

/* Hero */

.sobre{

    padding:120px 8% 80px;

    background:#f8fafc;

}

/* Título */

.titulo-sobre{

    text-align:center;

    max-width:900px;

    margin:0 auto 70px;

}

.titulo-sobre span{

    display:block;

    color:#1976d2;

    font-size:13px;

    font-weight:700;

    letter-spacing:2px;

    margin-bottom:12px;

}

.titulo-sobre h1{

    font-size:42px;

    color:#003366;

    margin-bottom:20px;

}

.titulo-sobre p{

    font-size:18px;

    color:#555;

    line-height:30px;

}

/* Conteúdo principal */

.sobre-grid{

    display:grid;

    grid-template-columns:1fr 1fr;

    gap:60px;

    align-items:center;

}

.texto h2{

    color:#003366;

    font-size:32px;

    margin-bottom:20px;

}

.texto p{

    color:#555;

    font-size:17px;

    line-height:30px;

    margin-bottom:20px;

}

/* Mini Cards */

.cards-pequenos{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));

    gap:20px;

    margin-top:35px;

}

.mini-card{

    background:white;

    padding:25px;

    border-radius:18px;

    box-shadow:0 8px 20px rgba(0,0,0,.08);

    transition:.3s;

}

.mini-card:hover{

    transform:translateY(-8px);

}

.mini-card.azul{

    border-left:5px solid #1976d2;

}

.mini-card.amarelo{

    border-left:5px solid #f4b400;

}

.mini-card h3{

    color:#003366;

    margin-bottom:12px;

    font-size:21px;

}

.mini-card p{

    color:#666;

    line-height:25px;

}

/* Imagem */

.imagem{

    position:relative;

}

.mapa{

    width:100%;

    border-radius:20px;

    box-shadow:0 10px 25px rgba(0,0,0,.12);

}

.contador{

    position:absolute;

    bottom:20px;

    left:20px;

    background:white;

    padding:18px 28px;

    border-radius:16px;

    box-shadow:0 10px 25px rgba(0,0,0,.15);

}

.contador h2{

    color:#1976d2;

    font-size:42px;

    margin-bottom:5px;

}

.contador p{

    color:#555;

}

/* Cards inferiores */

.valores{

    display:grid;

    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));

    gap:25px;

    margin-top:80px;

}

.valor{

    background:white;

    padding:30px;

    border-radius:18px;

    text-align:center;

    box-shadow:0 8px 20px rgba(0,0,0,.08);

    transition:.3s;

}

.valor:hover{

    transform:translateY(-8px);

}

.valor h3{

    color:#003366;

    margin-bottom:15px;

    font-size:22px;

}

.valor p{

    color:#666;

    line-height:28px;

}

/* Tecnologias */

.tecnologias{

    padding:90px 8%;

    background:white;

}

.tecnologias h2{

    text-align:center;

    color:#003366;

    font-size:36px;

    margin-bottom:50px;

}

/* Responsividade */

@media(max-width:900px){

    .sobre-grid{

        grid-template-columns:1fr;

    }

}

@media(max-width:700px){

    .titulo-sobre h1{

        font-size:32px;

    }

    .contador{

        position:static;

        margin-top:20px;

    }

    .cards-pequenos{

        grid-template-columns:1fr;

    }

}

